      "Bash(pnpm up*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm create*)",
      "Bash(pnpm fetch*)",
      "Bash(pnpm self-update*)",
      "Bash(pnpm publish*)",
      "Bash(pnpx *)",
      "Bash(corepack *)",
      "Bash(git remote*)",
      "Bash(git config*)",
      "Bash(gh release*)",
      "Bash(gh repo*)",
      "Read(./private-docs/**)",
      "Read(./CLAUDE.local.md)",
      "Edit(./.claude/**)",
      "Edit(./.githooks/**)",
      "Edit(./.github/**)",
      "Edit(./.local/**)",
      "Read(./.local/**)",
      "Edit(./.git)",
      "Edit(./.git/**)",
      "Edit(**/.git)",
      "Edit(**/.git/**)",
      "Read(**/private-docs/**)",
